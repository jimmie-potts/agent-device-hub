{
  "manifestVersion": "hub-compose/1",
  "services": [
    {
      "id": "nanoleaf",
      "role": "consumer",
      "app": "wall",
      "repository": "jimmie-potts/codex-nanoleaf",
      "revision": "4ddf14bcec94abd145919c8f8d6de332a4b19b9c",
      "coreVersion": "1.1.0",
      "scenario": "hub-paired",
      "run": ["node", "scripts/verify.mjs"]
    },
    {
      "id": "pixoo",
      "role": "consumer",
      "app": "pixoo",
      "repository": "jimmie-potts/divoom-app-upgrade",
      "revision": "59a3eb71e2969a548b69fe6423a1cd9655624387",
      "coreVersion": "1.1.0",
      "scenario": "hub-paired",
      "run": ["fnm", "exec", "--using=.nvmrc", "--", "node", "scripts/verify.mjs"]
    },
    {
      "id": "hub",
      "role": "owner",
      "app": "hub",
      "repository": "jimmie-potts/agent-device-hub",
      "revision": "self",
      "coreVersion": "1.3.0",
      "scenario": "integrated",
      "run": ["node", "scripts/verify.mjs"]
    }
  ]
}
