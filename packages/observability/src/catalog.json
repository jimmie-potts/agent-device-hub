  "attributes": {
    "bunny.controller.id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.device.id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.source.id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.request.id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.ticket.epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.operation.id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.task.epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.effect.epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.clock.epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "bunny.ticket.sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.state.revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.source.revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.telemetry.dropped_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.telemetry.failure_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bunny.duration_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400000
    },
    "bunny.queue.wait_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400000
    },
    "bunny.execution.duration_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400000
    },
    "bunny.operation": {
      "enum": [
        "startup",
        "shutdown",
        "brightness",
        "power",
        "mode",
        "status",
        "snapshot",
        "feed",
        "lifecycle",
        "automation",
        "moment",
        "playback",
        "media",
        "storage",
        "setup",
        "verification",
        "maintenance",
        "telemetry"
      ]
    },
    "bunny.outcome": {
      "enum": [
        "accepted",
        "queued",
        "succeeded",
        "rejected",
        "cancelled",
        "partial",
        "uncertain",
        "timeout",
        "unavailable",
        "stale",
        "current",
        "failed",
        "duplicate",
        "transport-acknowledged"
      ]
    },
    "bunny.reason": {
      "enum": [
        "invalid-input",
        "unauthorized",
        "busy",
        "duplicate",
        "cancelled",
        "timeout",
        "transport-error",
        "sink-error",
        "queue-full",
        "oversize",
        "unsupported-version",
        "invalid-context",
        "unavailable",
        "stale",
        "shutdown",
        "none"
      ]
    },
    "bunny.provenance": {
      "enum": [
        "source",
        "observation"
      ]
    },
    "bunny.observed.service": {
      "enum": [
        "hub",
        "hub-dashboard",
        "local-controllers",
        "tidbyt",
        "pixoo",
        "pixoo-web",
        "pixoo-media-worker",
        "nanoleaf-controller",
        "nanoleaf-worker",
        "nanoleaf-wall",
        "nanoleaf-wall-ui",
        "nanoleaf-mcp",
        "bunny-tool",
        "lifx"
      ]
    },
    "bunny.queue.depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "bunny.write.possible": {
      "type": "boolean"
    },
    "bunny.build.revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
    }
