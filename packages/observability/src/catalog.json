{
  "artifact_version": "1.1.0",
  "schema_versions": [
    "1.0",
    "1.1"
  ],
  "default_schema_version": "1.1",
  "semantic_conventions": "1.44.0",
  "events": {
    "process.started": "Process started",
    "process.stopped": "Process stopped",
    "process.failed": "Process failed",
    "command.admitted": "Command admitted",
    "command.rejected": "Command rejected",
    "command.queued": "Command queued",
    "command.executing": "Command executing",
    "command.completed": "Command completed",
    "command.cancelled": "Command cancelled",
    "lifecycle.observed": "Lifecycle observed",
    "feed.changed": "Feed state changed",
    "operation.completed": "Operation completed",
    "operation.failed": "Operation failed",
    "telemetry.dropped": "Diagnostic records dropped"
  },
  "services": [
    "hub",
    "hub-dashboard",
