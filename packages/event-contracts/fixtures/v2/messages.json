{
 "description": "Profile 2.0 fixtures (Hub #828). Each invalid case patches a valid message; null removes an attribute and a data patch replaces the whole payload. `detail` pins where the message fails; a oneOf failure names the oneOf's own location. `oversized` pads a valid message past the 256 KiB cap.",
 "schemas": {
  "https://bunny.invalid/events/example-session/2.0": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "revision",
    "status",
    "updatedAtMs",
    "ordering"
   ],
   "properties": {
    "id": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "revision": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "status": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/enumValue"
    },
    "updatedAtMs": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
    },
    "ordering": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/ordering"
    },
    "title": {
     "oneOf": [
      {
       "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/unknown"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "status",
        "value"
       ],
       "properties": {
        "status": {
         "const": "known"
        },
        "value": {
         "type": "string",
         "maxLength": 200
        }
       }
      }
     ]
    }
   }
  },
  "https://bunny.invalid/events/example-turn/2.0": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sessionId",
    "endedAtMs"
   ],
   "properties": {
    "sessionId": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "endedAtMs": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
    }
   }
  },
  "https://bunny.invalid/events/example-mode/2.0": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "requestId",
    "ticket",
    "mode"
   ],
   "properties": {
    "requestId": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "ticket": {
     "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/ticket"
    },
    "mode": {
     "enum": [
      "work",
      "quiet",
      "free"
     ]
    }
   }
  }
 },
