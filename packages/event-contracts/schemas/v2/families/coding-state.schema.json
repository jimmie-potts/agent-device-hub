{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-state/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "endpointId",
    "availability",
    "active"
  ],
  "properties": {
    "id": {
      "const": "coding"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "endpointId": {
      "anyOf": [
        {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/routingId"
        },
        {
          "type": "null"
        }
      ]
    },
    "availability": {
      "enum": [
        "off",
        "available",
        "unavailable"
      ]
    },
    "active": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operationId",
            "taskId",
            "status"
          ],
          "properties": {
            "operationId": {
              "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
            },
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9-]+$"
            },
            "status": {
              "enum": [
                "dispatching",
                "started",
                "cancelling",
                "uncertain"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
