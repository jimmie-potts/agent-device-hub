{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-endpoint/2.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "action",
    "capacity",
    "worker"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/requestId"
    },
    "readiness": {
      "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness"
    },
    "action": {
      "const": "enable"
    },
    "capacity": {
      "const": "uncapped"
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "installed",
          "version",
          "signedIn",
          "plan",
          "limits",
          "limitsObservedAtMs",
          "checkedAtMs",
          "harness",
          "capabilities"
        ],
        "properties": {
          "installed": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/installed"
          },
          "version": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/version"
          },
          "signedIn": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/signedIn"
          },
          "plan": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/plan"
          },
          "limits": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/limits"
          },
          "limitsObservedAtMs": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/limitsObservedAtMs"
          },
          "checkedAtMs": {
            "$ref": "https://bunny.invalid/events/coding-endpoint/2.2#/properties/readiness/properties/checkedAtMs"
          },
          "harness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steering",
              "resume",
              "review"
            ],
            "properties": {
              "steering": {
                "enum": [
                  "unsupported",
                  "live"
                ]
              },
              "resume": {
                "enum": [
                  "unsupported",
                  "saved-session"
                ]
              },
              "review": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "toolchains",
        "repositories",
        "pressure",
        "testSlots"
      ],
      "properties": {
        "os": {
          "enum": [
            "macos",
            "windows",
            "linux"
          ]
        },
        "toolchains": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "revision"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "pressure": {
          "enum": [
            "normal",
            "elevated",
            "high",
            "unknown"
          ]
        },
        "testSlots": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 64
        }
      }
    }
  }
}
