{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/microduck-dispatch/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "target",
    "gesture",
    "opportunityId",
    "expectedConfigurationRevision",
    "expectedGeneration",
    "validUntilMs"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "target": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/routingId"
    },
    "gesture": {
      "enum": [
        "notice",
        "attention"
      ]
    },
    "opportunityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expectedConfigurationRevision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "expectedGeneration": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/ticket"
    },
    "validUntilMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
