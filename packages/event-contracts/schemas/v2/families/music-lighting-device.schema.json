{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/music-lighting-device/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "session"
  ],
  "properties": {
    "id": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/routingId"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "session": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "status"
          ],
          "properties": {
            "generation": {
              "$ref": "#/$defs/generation"
            },
            "status": {
              "enum": [
                "starting",
                "playing"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "status",
            "ended"
          ],
          "properties": {
            "generation": {
              "$ref": "#/$defs/generation"
            },
            "status": {
              "const": "ended"
            },
            "ended": {
              "$ref": "#/$defs/ended"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "status",
            "show"
          ],
          "properties": {
            "generation": {
              "$ref": "#/$defs/generation"
            },
            "status": {
              "enum": [
                "starting",
                "playing",
                "paused"
              ]
            },
            "show": {
              "$ref": "#/$defs/show"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "presetId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^preset-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointId",
        "generation"
      ],
      "properties": {
        "endpointId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/routingId"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        }
      }
    },
    "ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "reason",
        "restoration",
        "atMs"
      ],
      "properties": {
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "reason": {
          "enum": [
            "stopped",
            "alert",
            "manual",
            "source-lost",
            "device",
            "restart",
            "expired",
            "refused",
            "completed"
          ]
        },
        "restoration": {
          "enum": [
            "restored",
            "skipped",
            "none",
            "uncertain"
          ]
        },
        "atMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "code": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/errorCode"
        },
        "missedCues": {
          "$ref": "#/$defs/missedCues"
        }
      }
    },
    "missedCues": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "showId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^show-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "showVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "positionMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800000
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showId",
        "version",
        "positionMs",
        "missedCues"
      ],
      "properties": {
        "showId": {
          "$ref": "#/$defs/showId"
        },
        "version": {
          "$ref": "#/$defs/showVersion"
        },
        "positionMs": {
          "$ref": "#/$defs/positionMs"
        },
        "missedCues": {
          "$ref": "#/$defs/missedCues"
        }
      }
    }
  }
}
