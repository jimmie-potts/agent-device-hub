{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/music-capture-progress/2.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "generation",
        "status"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "started",
            "stopped"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "generation",
        "status",
        "error"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "failed",
            "uncertain"
          ]
        },
        "error": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/errorBody/properties/error",
          "propertyNames": {
            "enum": [
              "code",
              "retryable"
            ]
          },
          "type": "object"
        }
      }
    }
  ]
}
