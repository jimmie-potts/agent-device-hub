{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/music-capture-features/2.1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "input",
        "sequence",
        "sampleRateHz",
        "channels",
        "frameCount",
        "startMonotonicMs",
        "endMonotonicMs",
        "emittedMonotonicMs",
        "observedAtMs",
        "validUntilMs",
        "rms",
        "peak",
        "clippedFraction",
        "bands",
        "onset",
        "discontinuity"
      ],
      "properties": {
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input": {
          "const": "music"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sampleRateHz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000,
          "multipleOf": 10
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "frameCount": {
          "type": "integer",
          "minimum": 800,
          "maximum": 19200
        },
        "startMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "emittedMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "validUntilMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "rms": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "peak": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "clippedFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bass",
            "mid",
            "treble"
          ],
          "properties": {
            "bass": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "mid": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "treble": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            }
          }
        },
        "onset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength",
            "confidence"
          ],
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "discontinuity": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "input",
        "sequence",
        "sampleRateHz",
        "channels",
        "frameCount",
        "startMonotonicMs",
        "endMonotonicMs",
        "emittedMonotonicMs",
        "observedAtMs",
        "validUntilMs",
        "rms",
        "peak",
        "clippedFraction",
        "bands",
        "onset",
        "discontinuity",
        "microphoneId"
      ],
      "properties": {
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input": {
          "const": "microphone"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sampleRateHz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000,
          "multipleOf": 10
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "frameCount": {
          "type": "integer",
          "minimum": 800,
          "maximum": 19200
        },
        "startMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "emittedMonotonicMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "validUntilMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "rms": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "peak": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "clippedFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bass",
            "mid",
            "treble"
          ],
          "properties": {
            "bass": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "mid": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "treble": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            }
          }
        },
        "onset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength",
            "confidence"
          ],
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "discontinuity": {
          "type": "boolean"
        },
        "microphoneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    }
  ]
}
