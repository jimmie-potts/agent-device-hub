          "$ref": "https://bunny.invalid/events/coding-progress/2.1#/oneOf/1/properties/status"
        },
        "result": {
          "$ref": "https://bunny.invalid/events/coding-progress/2.1#/oneOf/1/properties/result"
        },
        "harness": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "handoffToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
