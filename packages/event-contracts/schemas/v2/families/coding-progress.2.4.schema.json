{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-progress/2.4",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
