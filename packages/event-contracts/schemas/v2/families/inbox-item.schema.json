{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/inbox-item/2.0",
  "description": "State: one item in the core's shared inbox, the full record (ADR 0012, Hub #842). An item is a failed or uncertain operation, a result a person must decide on. A finished turn is never an inbox item: its unread state stays on the session record (owner decision 7, 2026-10-06), and Hub #782 removed the turn-ended item. An item stays until handled, with no expiry; handling it publishes a removal whose reason is `deleted`. `dismissedBy` lists the displays that dismissed it, a separate fact that does not handle it. An operation's optional `evidence` is its outcome's evidence, so a person can see whether anything reached the device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "createdAtMs", "dismissedBy", "item"],
  "properties": {
    "id": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"},
    "revision": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"},
    "createdAtMs": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"},
    "dismissedBy": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"}},
    "item": {"type": "object", "additionalProperties": false, "required": ["kind", "requestId", "command", "target", "result"],
      "properties": {
        "kind": {"const": "operation"},
        "requestId": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"},
        "command": {"type": "string", "pattern": "^org\\.bunny(\\.[a-z][a-z0-9-]*){2,3}\\.requested$", "maxLength": 256},
        "target": {"type": "string", "minLength": 1, "maxLength": 256},
        "result": {"enum": ["failed", "uncertain"]},
        "evidence": {"$ref": "https://bunny.invalid/events/kinds/2.0#/$defs/outcome/properties/evidence"},
        "error": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/errorBody/properties/error"}
      },
      "if": {"properties": {"result": {"const": "failed"}}},
      "then": {"required": ["error"], "properties": {"error": true}}}
  }
}
