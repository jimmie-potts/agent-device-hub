{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/moment-play/2.2",
  "description": "Exact art may carry a closed rain forecast annotation. The label is separate from stored decorative bytes. A notice requires art and affirmative notice capability; ordinary art retains2.1. Freshness must cover the latest permitted start and complete duration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "momentId",
    "mood",
    "durationMs",
    "priorityClass",
    "coversStatus",
    "startAtMs",
    "toleranceMs"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "momentId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "mood": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/enumValue"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "priorityClass": {
      "enum": [
        "event",
        "flourish"
      ]
    },
    "coversStatus": {
      "type": "boolean"
    },
    "startAtMs": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
    },
    "toleranceMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compositionId"
      ],
      "properties": {
        "compositionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "likelihood",
        "forecastStartAtMs",
        "forecastEndAtMs",
        "forecastUpdatedAtMs",
        "observedAtMs",
        "staleAtMs",
        "weatherRevision"
      ],
      "properties": {
        "kind": {
          "const": "rain-forecast"
        },
        "likelihood": {
          "enum": [
            "chance",
            "likely"
          ]
        },
        "forecastStartAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "forecastEndAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "forecastUpdatedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "observedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "staleAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "weatherRevision": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
        }
      }
    }
  },
  "if": {
    "properties": {
      "priorityClass": {
        "const": "flourish"
      }
    }
  },
  "then": {
    "properties": {
      "coversStatus": {
        "const": false
      }
    }
  },
  "dependentRequired": {
    "notice": [
      "art"
    ]
  }
}
