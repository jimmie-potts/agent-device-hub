{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/automation-interrupt-set/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "kinds"
  ],
  "properties": {
    "id": {
      "const": "interrupt-set"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "kinds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){0,3}$"
      }
    }
  }
}
