{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/automation-settings/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "noFlourishes",
    "quietHours",
    "budgets"
  ],
  "properties": {
    "id": {
      "const": "settings"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "noFlourishes": {
      "type": "boolean"
    },
    "quietHours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "start",
        "end",
        "timeZone"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timeZone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perAgentTask",
        "perAgentHour",
        "globalHour",
        "deviceSpacingMs"
      ],
      "properties": {
        "perAgentTask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "perAgentHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "globalHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "deviceSpacingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    }
  }
}
