{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/lighting-layout/2.0",
  "description": "Private core-owned lighting composition, never a device command (Hub #1135). Null Home selection discovers all lights; an array saves an explicit selection.",
  "type": "object", "additionalProperties": false,
  "required": ["id", "revision", "layout"],
  "properties": {
    "id": {"const": "lighting"},
    "revision": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"},
    "layout": {"$ref": "#/$defs/layout"}
  },
  "$defs": {
    "id": {"$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/routingId"},
    "name": {"type": "string", "$ref": "https://bunny.invalid/events/session/2.0#/$defs/displayText", "maxLength": 80},
    "room": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["device", "room"], "properties": {"device": {"$ref": "#/$defs/id"}, "room": {"$ref": "#/$defs/id"}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "name", "scope", "devices"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"},
      "scope": {"type": "string", "maxLength": 128, "pattern": "^(?:home|brand-[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"},
      "devices": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
    }},
    "selection": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["device", "room", "group"]}, "id": {"$ref": "#/$defs/id"}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["rooms", "assignments", "groups", "home"], "properties": {
      "rooms": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/room"}},
      "assignments": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/assignment"}},
      "groups": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/group"}},
      "home": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/selection"}}]}
    }}
  }
}
