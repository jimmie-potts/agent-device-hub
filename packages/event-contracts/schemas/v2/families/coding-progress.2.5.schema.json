{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-progress/2.5",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "messageId",
        "status",
        "sessionId"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "messageId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "status": {
          "const": "message-observed"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "status": {
          "const": "attempt-context"
        },
        "worktreeRef": {
          "type": "string",
          "pattern": "^bunny-[A-Za-z0-9_-]{1,100}$"
        },
        "branch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "minProperties": 3
    }
  ]
}
