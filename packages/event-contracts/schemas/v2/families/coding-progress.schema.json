{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-progress/2.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "status": {
          "const": "started"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "result"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "status": {
          "const": "completed"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "repository",
            "base",
            "head",
            "changedFiles",
            "checks",
            "findings",
            "limitations",
            "summary",
            "sessionId",
            "usage"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "tested-candidate",
                "incomplete",
                "failed"
              ]
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
            },
            "base": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "head": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "changedFiles": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "checks": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "status": {
                    "enum": [
                      "passed",
                      "failed",
                      "skipped",
                      "unrun",
                      "unknown"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "maxLength": 1024
                  }
                }
              }
            },
            "findings": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "limitations": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sessionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z0-9-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "turns",
                    "costUsd",
                    "durationMs"
                  ],
                  "properties": {
                    "turns": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "costUsd": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "durationMs": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "reason"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled",
            "uncertain"
          ]
        },
        "reason": {
          "enum": [
            "refused",
            "repository",
            "worktree",
            "exit",
            "timeout",
            "budget",
            "cancelled",
            "lost",
            "invalid-output"
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome",
                "repository",
                "base",
                "head",
                "changedFiles",
                "checks",
                "findings",
                "limitations",
                "summary",
                "sessionId",
                "usage"
              ],
              "properties": {
                "outcome": {
                  "enum": [
                    "tested-candidate",
                    "incomplete",
                    "failed"
                  ]
                },
                "repository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
                },
                "base": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "head": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "changedFiles": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "checks": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "status"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "status": {
                        "enum": [
                          "passed",
                          "failed",
                          "skipped",
                          "unrun",
                          "unknown"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "maxLength": 1024
                      }
                    }
                  }
                },
                "findings": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "limitations": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sessionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z0-9-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usage": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "turns",
                        "costUsd",
                        "durationMs"
                      ],
                      "properties": {
                        "turns": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "costUsd": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "durationMs": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ]
}
