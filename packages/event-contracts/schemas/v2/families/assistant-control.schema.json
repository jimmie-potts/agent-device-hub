{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/assistant-control/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedRevision",
    "action"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "expectedRevision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "action": {
      "enum": [
        "enable",
        "disable",
        "resume",
        "cancel"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9-]+$"
    }
  }
}
