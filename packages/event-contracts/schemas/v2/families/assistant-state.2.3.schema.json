{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/assistant-state/2.3",
  "description": "Assistant state 2.3 (Hub #2031) is 2.2 with a queue's `messages` allowed up to 16. Steers that a stopped or closed turn never read go back to the head of its conversation's queue even when that passes the queue's limit of 8, so nothing the owner wrote is dropped, and a new message is not queued until the queue is below 8 again. A queue and its task's unread steers together hold at most 16. The companions module publishes 2.3 only while some queue holds more than 8 messages. It carries no message text. Every other member is 2.2's.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "enabled",
    "available",
    "provider",
    "model",
    "tools",
    "tasks",
    "queues"
  ],
  "properties": {
    "id": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/id"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/revision"
    },
    "enabled": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/enabled"
    },
    "available": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/available"
    },
    "provider": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/provider"
    },
    "model": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/model"
    },
    "tools": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/tools"
    },
    "tasks": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/tasks"
    },
    "queues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversationId",
          "profile",
          "messages",
          "held",
          "code"
        ],
        "properties": {
          "conversationId": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/queues/items/properties/conversationId"
          },
          "profile": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/queues/items/properties/profile"
          },
          "messages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "held": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/queues/items/properties/held"
          },
          "code": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.2#/properties/queues/items/properties/code"
          }
        }
      }
    }
  }
}
