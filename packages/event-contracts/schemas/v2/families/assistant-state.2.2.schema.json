{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/assistant-state/2.2",
  "description": "Assistant state 2.2 (Hub #2030) is 2.1 with the message queue of each profile's current conversation that holds messages: how many wait, whether the queue is held and why (`stop` after the owner stopped a task, `restart` after the runtime started again, `refused` when the next message could not start), and the refusal's code. It carries no message text. Task and identity fields remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "enabled",
    "available",
    "provider",
    "model",
    "tools",
    "tasks",
    "queues"
  ],
  "properties": {
    "id": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/id"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/revision"
    },
    "enabled": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/enabled"
    },
    "available": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/available"
    },
    "provider": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/provider"
    },
    "model": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/model"
    },
    "tools": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.1#/properties/tools"
    },
    "tasks": {
      "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/tasks"
    },
    "queues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversationId",
          "profile",
          "messages",
          "held",
          "code"
        ],
        "properties": {
          "conversationId": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/tasks/items/properties/conversationId"
          },
          "profile": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/tasks/items/properties/profile"
          },
          "messages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "held": {
            "enum": [
              "stop",
              "restart",
              "refused",
              null
            ]
          },
          "code": {
            "$ref": "https://bunny.invalid/events/assistant-state/2.0#/properties/tasks/items/properties/code"
          }
        }
      }
    }
  }
}
