{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/assistant-control/2.1",
  "description": "Version 2.1 (Hub #2025): 2.0 with the action `rename`, which names a profile's conversation with the owner's title. A rename carries `profile` and `title` and no task or message; every other action carries neither.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedRevision",
    "action"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "expectedRevision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "action": {
      "enum": [
        "enable",
        "disable",
        "resume",
        "cancel",
        "speak",
        "rename"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "profile": {
      "enum": [
        "bunny",
        "reachy",
        "microduck"
      ]
    },
    "title": {
      "type": "string",
      "$ref": "https://bunny.invalid/events/session/2.0#/$defs/displayText",
      "maxLength": 80
    }
  },
  "if": {
    "properties": {
      "action": {
        "const": "rename"
      }
    }
  },
  "then": {
    "required": [
      "profile",
      "title"
    ],
    "properties": {
      "profile": true,
      "title": true,
      "taskId": false,
      "messageId": false
    }
  },
  "else": {
    "properties": {
      "profile": false,
      "title": false
    }
  }
}
