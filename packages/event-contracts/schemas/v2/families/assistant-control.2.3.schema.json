{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/assistant-control/2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "action",
    "jobId",
    "operationId",
    "harness"
  ],
  "properties": {
    "requestId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "action": {
      "const": "continue-coding-job"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,132}$"
    },
    "operationId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "harness": {
      "enum": [
        "claude-code",
        "codex"
      ]
    }
  }
}
