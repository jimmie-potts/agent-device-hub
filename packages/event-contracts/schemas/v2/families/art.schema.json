{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/art/2.0",
  "description": "State: the art module's private catalog summary and spending (Hub #680): per-provider spent, reserved, uncertain and remaining micro-dollars, recent jobs and artworks by reference, and the staged candidates the automation path may show. It carries no prompt, key, location or image bytes; bytes are read through the module's authenticated content references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "month",
    "day",
    "providers",
    "guard",
    "gifs",
    "jobs",
    "artworks",
    "candidates",
    "retention"
  ],
  "properties": {
    "id": {
      "const": "art"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "available",
          "ceilingMicros",
          "paceMicros",
          "spentMicros",
          "reservedMicros",
          "uncertainMicros",
          "remainingMicros",
          "todayMicros",
          "excessMicros",
          "earlierUncertainMicros"
        ],
        "properties": {
          "provider": {
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "ceilingMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "paceMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spentMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reservedMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uncertainMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remainingMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "todayMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excessMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "earlierUncertainMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "limit",
        "windowMs"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "windowMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "gifs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rejected"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "purpose",
          "admittedBy",
          "status",
          "outcome",
          "artworkId",
          "createdAtMs",
          "finishedAtMs",
          "targets"
        ],
        "properties": {
          "requestId": {
            "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
          },
          "purpose": {
            "enum": [
              "request",
              "ambient",
              "appearance",
              "variation"
            ]
          },
          "admittedBy": {
            "enum": [
              "owner",
              "automatic"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "finished"
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "succeeded",
                  "partial",
                  "failed",
                  "uncertain",
                  "rejected",
                  "cancelled"
                ]
              }
            ]
          },
          "artworkId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "createdAtMs": {
            "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
          },
          "finishedAtMs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
              }
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "outcome",
                "code",
                "reason"
              ],
              "properties": {
                "target": {
                  "enum": [
                    "ui",
                    "tidbyt",
                    "pixoo"
                  ]
                },
                "outcome": {
                  "enum": [
                    "pending",
                    "succeeded",
                    "failed",
                    "uncertain",
                    "rejected",
                    "cancelled"
                  ]
                },
                "code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/errorCode"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "no-key",
                        "unsupported",
                        "unknown-price",
                        "monthly-ceiling",
                        "daily-pace",
                        "loop-guard",
                        "moderation",
                        "provider-refused",
                        "invalid-output",
                        "preview-refused",
                        "lost-response",
                        "restart",
                        "cancelled",
                        "storage"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "artworks": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artworkId",
          "createdAtMs",
          "favorite",
          "feedback",
          "variationOf",
          "palette",
          "provenance",
          "compositions"
        ],
        "properties": {
          "artworkId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "createdAtMs": {
            "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
          },
          "favorite": {
            "type": "boolean"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "more",
                  "less",
                  "dismiss"
                ]
              }
            ]
          },
          "variationOf": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              }
            ]
          },
          "palette": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generatedBy",
              "factual"
            ],
            "properties": {
              "generatedBy": {
                "enum": [
                  "openai",
                  "local"
                ]
              },
              "factual": {
                "const": false
              }
            }
          },
          "compositions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "compositionId",
                "outcome",
                "motion",
                "renditions"
              ],
              "properties": {
                "target": {
                  "enum": [
                    "ui",
                    "tidbyt",
                    "pixoo"
                  ]
                },
                "compositionId": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "succeeded",
                    "partial",
                    "failed",
                    "uncertain",
                    "rejected",
                    "cancelled"
                  ]
                },
                "motion": {
                  "enum": [
                    "still",
                    "gif",
                    "local"
                  ]
                },
                "renditions": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "renditionId",
                      "width",
                      "height",
                      "frames",
                      "durationMs",
                      "format",
                      "bytes",
                      "ref"
                    ],
                    "properties": {
                      "renditionId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "frames": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 64
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60000
                      },
                      "format": {
                        "enum": [
                          "png",
                          "gif",
                          "webp"
                        ]
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16777216
                      },
                      "ref": {
                        "type": "string",
                        "pattern": "^rendition\\.[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artworkId",
          "target",
          "compositionId",
          "favorite",
          "stagedUntilMs"
        ],
        "properties": {
          "artworkId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "target": {
            "enum": [
              "tidbyt",
              "pixoo"
            ]
          },
          "compositionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "favorite": {
            "type": "boolean"
          },
          "stagedUntilMs": {
            "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recentLimit",
        "recent",
        "favorites",
        "retained"
      ],
      "properties": {
        "recentLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "recent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "favorites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retained": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artworkId",
              "target",
              "untilMs"
            ],
            "properties": {
              "artworkId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "target": {
                "enum": [
                  "tidbyt",
                  "pixoo"
                ]
              },
              "untilMs": {
                "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
              }
            }
          }
        }
      }
    }
  }
}
