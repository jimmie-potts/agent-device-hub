{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/music-playback-result/2.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "processEpoch",
        "action",
        "status"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "processEpoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": {
          "enum": [
            "play",
            "pause",
            "next",
            "previous"
          ]
        },
        "status": {
          "const": "sent"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "processEpoch",
        "action",
        "status",
        "error"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
        },
        "processEpoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": {
          "enum": [
            "play",
            "pause",
            "next",
            "previous"
          ]
        },
        "status": {
          "enum": [
            "unsent",
            "refused",
            "uncertain"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/errorCode"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
