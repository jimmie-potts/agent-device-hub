{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/coding-progress/2.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "status",
    "state",
    "observedAtMs",
    "clients"
  ],
  "properties": {
    "operationId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/requestId"
    },
    "status": {
      "const": "native-client"
    },
    "state": {
      "enum": [
        "available",
        "terminal",
        "terminal-closed",
        "desktop",
        "uncertain"
      ]
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "terminal",
          "claude-desktop"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    }
  }
}
