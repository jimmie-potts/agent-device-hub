{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/session/2.1",
  "description": "An explicit read receipt on the existing session identity. The owner binds provenance to its exact known finished turn; lifecycle freshness and consumer acknowledgments are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "generation",
    "identity",
    "parent",
    "turn",
    "activity",
    "attention",
    "notices",
    "read",
    "unavailable",
    "ordering",
    "observedAtMs",
    "lastEvidenceAtMs",
    "freshness",
    "restartUncertain",
    "children",
    "readReceipt"
  ],
  "properties": {
    "id": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "revision": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "generation": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "parent": {
      "oneOf": [
        {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "top-level"
            }
          }
        }
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "id"
      ],
      "properties": {
        "status": {
          "const": "known"
        },
        "id": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
        }
      }
    },
    "activity": {
      "enum": [
        "idle",
        "interrupted"
      ]
    },
    "attention": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/attention"
      }
    },
    "notices": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "read": {
      "const": "read"
    },
    "unavailable": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/unavailable"
      }
    },
    "ordering": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/ordering"
    },
    "observedAtMs": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
    },
    "lastEvidenceAtMs": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
    },
    "freshness": {
      "enum": [
        "current",
        "uncertain"
      ]
    },
    "restartUncertain": {
      "type": "boolean"
    },
    "children": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "uncertain"
      ],
      "properties": {
        "active": {
          "$ref": "#/$defs/count"
        },
        "uncertain": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "label": {
      "$ref": "#/$defs/label"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "projectId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "hostSessionId": {
      "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
    },
    "readReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noticeId",
        "observedAtMs",
        "source",
        "receipt"
      ],
      "properties": {
        "noticeId": {
          "$ref": "#/$defs/hash"
        },
        "observedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "source": {
          "type": "string",
          "pattern": "^bunny(/[a-z0-9][a-z0-9-]*)+$",
          "maxLength": 256
        },
        "receipt": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "client",
                "seenRevision",
                "acceptedRevision"
              ],
              "properties": {
                "kind": {
                  "const": "provider-client"
                },
                "client": {
                  "const": "desktop"
                },
                "seenRevision": {
                  "$ref": "#/$defs/providerRevision"
                },
                "acceptedRevision": {
                  "$ref": "#/$defs/providerRevision"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "viewRevision"
              ],
              "properties": {
                "kind": {
                  "const": "owned-ui"
                },
                "viewRevision": {
                  "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/hostSessionOnlyAtRoot"
    },
    {
      "if": {
        "properties": {
          "restartUncertain": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "freshness": {
            "const": "uncertain"
          }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identity": {
      "description": "The native session selector. Codex uses cli, desktop or shared local (surface unspecified); Claude uses code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "client",
        "hostId",
        "sourceId",
        "sessionId"
      ],
      "properties": {
        "provider": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "client": {
          "enum": [
            "cli",
            "desktop",
            "code",
            "local"
          ]
        },
        "hostId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
        },
        "sourceId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
        },
        "sessionId": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
        }
      },
      "if": {
        "properties": {
          "provider": {
            "const": "codex"
          }
        }
      },
      "then": {
        "properties": {
          "client": {
            "enum": [
              "cli",
              "desktop",
              "local"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "client": {
            "const": "code"
          }
        }
      }
    },
    "knownId": {
      "oneOf": [
        {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "id"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "id": {
              "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
            }
          }
        }
      ]
    },
    "parent": {
      "oneOf": [
        {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "top-level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "identity"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "identity": {
              "$ref": "#/$defs/identity"
            }
          }
        }
      ]
    },
    "attentionKind": {
      "enum": [
        "question",
        "input",
        "approval"
      ]
    },
    "attention": {
      "description": "One attention item. `turn` is the turn the item was raised on, which an occurrence's own `turn` may have left behind.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "turn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/knownId"
        },
        "kind": {
          "$ref": "#/$defs/attentionKind"
        },
        "turn": {
          "$ref": "#/$defs/knownId"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "turn",
        "acknowledgedBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "const": "turn-ended"
        },
        "turn": {
          "$ref": "#/$defs/knownId"
        },
        "acknowledgedBy": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
          }
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "reason"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "activity",
            "attention",
            "turn",
            "parent",
            "read",
            "ordering"
          ]
        },
        "reason": {
          "enum": [
            "unsupported",
            "inaccessible",
            "missing",
            "ambiguous",
            "lost"
          ]
        }
      }
    },
    "displayText": {
      "description": "1 to 160 Unicode scalar values with no control characters and no recognizable credential.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?![\\s\\S]*(?:[Bb][Ee][Aa][Rr][Ee][Rr] +[A-Za-z0-9._~+/-]{12,}|(?:sk-|gh[pousr]_|github_pat_)[A-Za-z0-9_-]{16,}|AKIA[A-Z0-9]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt])\\s*[:=]\\s*\\S+))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "string",
          "$ref": "#/$defs/displayText",
          "maxLength": 80
        },
        "origin": {
          "enum": [
            "user",
            "agent"
          ]
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/displayText"
        },
        "source": {
          "enum": [
            "provider",
            "user"
          ]
        }
      }
    },
    "project": {
      "type": "string",
      "$ref": "#/$defs/displayText",
      "maxLength": 80
    },
    "hostSessionOnlyAtRoot": {
      "description": "A record or observation whose parent is known never carries a host session ID.",
      "type": "object",
      "if": {
        "properties": {
          "parent": {
            "type": "object",
            "properties": {
              "status": {
                "const": "known"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "hostSessionId": false
        }
      }
    },
    "occurrence": {
      "description": "What every agent occurrence carries: the session it happened to, the observation's turn and evidence, and the owner revision that committed it.",
      "type": "object",
      "required": [
        "session",
        "identity",
        "turn",
        "observedAtMs",
        "ordering",
        "revision"
      ],
      "properties": {
        "session": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/id"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "turn": {
          "$ref": "#/$defs/knownId"
        },
        "observedAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "occurredAtMs": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/instantMs"
        },
        "ordering": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/ordering"
        },
        "revision": {
          "$ref": "https://bunny.invalid/events/blocks/2.0#/$defs/revision"
        }
      }
    },
    "providerRevision": {
      "description": "Opaque provider token, including native initial:<thread-id> revisions. Never parse it as an ordering value.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    }
  }
}
