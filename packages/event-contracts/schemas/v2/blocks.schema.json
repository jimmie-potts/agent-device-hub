{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny.invalid/events/blocks/2.0",
  "description": "Shared building blocks for B.U.N.N.Y. profile 2.0 payloads (ADR 0012).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "requestId": {
      "$ref": "#/$defs/id"
    },
    "routingId": {
      "description": "An identifier that is also the last token of the entity's SDK routing keys (ADR 0012): lowercase letters and digits with single hyphens, at most 128 characters.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "instantMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "sequence"
      ],
      "properties": {
        "epoch": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ordering": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "authority",
            "epoch",
            "sequence"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "authority": {
              "$ref": "#/$defs/id"
            },
            "epoch": {
              "$ref": "#/$defs/id"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        }
      }
    },
    "enumValue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "id"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/enumValue"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/errorCode"
            },
            "retryable": {
              "type": "boolean"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "traceId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "enum": [
                      "capacity",
                      "unavailable"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "retryable": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            }
          ]
        }
      }
    },
    "errorCode": {
      "description": "A code from errors.json. The registry also fixes retryable: true only for the codes listed in errorBody's condition.",
      "enum": [
        "invalid-request",
        "invalid-message",
        "too-large",
        "unsupported-version",
        "unknown-schema",
        "unsupported-capability",
        "unauthenticated",
        "forbidden",
        "not-found",
        "invalid-state",
        "revision-conflict",
        "duplicate-conflict",
        "expired",
        "cancelled",
        "capacity",
        "unavailable",
        "uncertain-result",
        "internal"
      ]
    }
  }
}
