{
  "catalogVersion": "guide-views/1.0",
  "recordsVersion": "guide-records/2.0",
  "bounds": {
    "maxDepth": 3,
    "composed": {
      "maxComponents": 48,
      "maxRootComponents": 6,
      "maxChildren": 12,
      "maxReasons": 3,
      "maxEvidence": 4
    }
  },
  "layouts": {
    "stack": "One reading column at every width; order is root order, then child order.",
    "columns": "Sections side by side where width allows and one column on narrow screens; reading order is unchanged."
  },
  "pages": {
    "home": { "record": "none", "origin": "ordinary", "groups": ["epics", "current-work", "newly-added", "open-defects"], "coverage": "none" },
    "epic": { "record": "epic", "origin": "ordinary", "groups": ["in-progress", "up-next", "blocked", "backlog", "later", "recently-done", "parent-group", "sub-epics", "relationships"], "coverage": "primary" },
    "not-in-epic": { "record": "none", "origin": "ordinary", "groups": ["not-in-epic", "backlog", "parent-group"], "coverage": "primary" },
    "all": { "record": "none", "origin": "ordinary", "groups": ["all"], "coverage": "complete" },
    "portfolio": { "record": "none", "origin": "ordinary", "groups": ["portfolio"], "coverage": "none" },
    "issue": { "record": "issue", "origin": "ordinary", "groups": ["relationships"], "coverage": "none", "brief": true },
    "answer": { "record": "none", "origin": "composed", "groups": ["matches", "relationships"], "coverage": "none" }
  },
  "components": {
    "section": {
      "record": "optional",
      "parents": ["root"],
      "children": ["epic-summary", "issue-card", "dependency-list", "board"],
      "properties": { "sequence": ["none", "suggested"], "disclosure": ["open", "collapsed"] }
    },
    "epic-summary": {
      "record": "epic",
      "parents": ["section", "board"],
      "children": [],
      "requiredData": ["id", "url", "title", "state", "labels", "story", "placement", "project"]
    },
    "issue-card": {
      "record": "issue",
      "parents": ["section", "board"],
      "children": [],
      "properties": { "presentation": ["card", "row"] },
      "requiredData": ["id", "url", "title", "state", "stateReason", "labels", "facts", "blockedBy", "placement", "project"]
    },
    "dependency-list": {
      "record": "issue",
      "parents": ["section"],
      "children": [],
      "properties": { "direction": ["prerequisites", "dependents"], "scope": ["direct", "transitive"] },
      "requiredData": ["id", "url", "state", "facts", "blockedBy"]
    },
    "board": {
      "record": "none",
      "parents": ["section"],
      "children": ["epic-summary", "issue-card"],
      "properties": { "by": ["commitment", "phase", "workflow"] }
    },
    "task-brief": {
      "record": "issue",
      "parents": ["root"],
      "children": [],
      "commands": ["explain", "plan", "implement", "review"],
      "requiredData": ["id", "url", "title", "planning"]
    }
  },
  "groups": {
    "epics": { "heading": "Epics", "children": ["epic-summary"], "requires": "root-epic" },
    "current-work": { "heading": "Current work", "children": ["issue-card"], "requires": "active" },
    "newly-added": { "heading": "Newly added", "children": ["issue-card"], "requires": "open" },
    "open-defects": { "heading": "Open defects", "children": ["issue-card"], "requires": "open-bug" },
    "in-progress": { "heading": "In progress", "children": ["issue-card"], "requires": "active" },
    "up-next": { "heading": "Up next", "children": ["issue-card"], "requires": "open", "requiresReason": "ready-candidate" },
    "blocked": { "heading": "Blocked", "children": ["issue-card"], "requires": "blocked" },
    "backlog": { "heading": "Other open work", "children": ["issue-card"], "requires": "open" },
    "later": { "heading": "Later", "children": ["issue-card"], "requires": "later" },
    "recently-done": { "heading": "Recently done", "children": ["issue-card"], "requires": "closed" },
    "parent-group": { "heading": "{record}", "record": true, "children": ["issue-card"], "requires": "descendant" },
    "sub-epics": { "heading": "Epics inside this epic", "children": ["epic-summary"], "requires": "nested-epic" },
    "not-in-epic": { "heading": "Not in an epic", "children": ["issue-card"], "requires": "not-in-epic" },
    "all": { "heading": "All issues", "children": ["issue-card"], "requires": "open" },
    "portfolio": { "heading": "Portfolio", "children": ["board"], "requires": "none" },
    "matches": { "heading": "Relevant to your question", "children": ["issue-card", "epic-summary"], "requires": "none" },
    "relationships": { "heading": "Recorded relationships", "children": ["dependency-list"], "requires": "none" }
  },
  "predicates": {
    "none": "No record condition.",
    "open": "The issue is open.",
    "active": "The issue is open with status:in-progress or status:review.",
    "open-bug": "The issue is open with the bug label.",
    "blocked": "The issue is open with the blocked label, an open or missing native blocker, or an unknown blocker list.",
    "later": "The issue is open with the deferred or idea label.",
    "closed": "The issue is closed, with its closure reason kept.",
    "descendant": "The section's record appears in the issue's placement path.",
    "root-epic": "The epic has root placement.",
    "nested-epic": "The epic's nearest containing epic is the page's epic.",
    "not-in-epic": "The issue's placement is standalone or unresolved."
  },
  "sequences": {
    "none": "No order is claimed.",
    "suggested": "Suggested reading order, not a recorded dependency."
  },
  "dependencyHeadings": {
    "prerequisites": "Recorded prerequisites of {record}",
    "dependents": "Recorded dependents of {record}"
  },
  "boards": {
    "commitment": { "columns": "project.commitments", "extra": ["Unselected", "Unknown"] },
    "phase": { "columns": "project.phases", "extra": ["Unassigned", "Conflict", "Unknown"] },
    "workflow": { "columns": ["status:backlog", "status:ready", "status:in-progress", "status:review"], "extra": ["Closed", "No single status"] }
  },
  "reasons": {
    "question-match": {
      "template": "Matches your question in {fields}",
      "evidence": "field",
      "components": ["issue-card", "epic-summary"],
      "claim": "relevance"
    },
    "epic-member": {
      "template": "Part of {epic}",
      "evidence": "epic",
      "components": ["issue-card"],
      "claim": "native parent membership"
    },
    "recorded-relation": {
      "template": "{relation} {record}",
      "evidence": "native-relation",
      "components": ["issue-card"],
      "claim": "native GitHub relationship"
    },
    "ready-candidate": {
      "template": "Ready by current recorded evidence",
      "withheldTemplate": "Readiness not established",
      "evidence": "none",
      "components": ["issue-card"],
      "claim": "guide-records ready gate"
    }
  },
  "relations": {
    "blocks": "Prerequisite of",
    "blocked-by": "Blocked by",
    "parent-of": "Parent of",
    "child-of": "Sub-issue of"
  },
  "routes": {
    "home": "",
    "epic": "epics/{owner}/{repo}/{number}/",
    "not-in-epic": "not-in-epic/",
    "all": "all/",
    "portfolio": "portfolio/",
    "issue": "{page}#{owner}/{repo}/{number}"
  }
}
