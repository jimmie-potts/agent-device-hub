{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:bunny:guide-views:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordsVersion",
    "datasetId",
    "catalogId",
    "origin",
    "page",
    "layout",
    "root",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": "guide-views/1.0"
    },
    "recordsVersion": {
      "const": "guide-records/2.0"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "origin": {
      "enum": [
        "ordinary",
        "composed"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record"
      ],
      "properties": {
        "kind": {
          "enum": [
            "home",
            "epic",
            "not-in-epic",
            "all",
            "portfolio",
            "issue",
            "answer"
          ]
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/issueRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "layout": {
      "enum": [
        "stack",
        "columns"
      ]
    },
    "root": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/section"
          },
          {
            "$ref": "#/$defs/epicSummary"
          },
          {
            "$ref": "#/$defs/issueCard"
          },
          {
            "$ref": "#/$defs/dependencyList"
          },
          {
            "$ref": "#/$defs/board"
          },
          {
            "$ref": "#/$defs/taskBrief"
          }
        ]
      }
    }
  },
  "$defs": {
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "issueRef": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "group",
        "record",
        "sequence",
        "disclosure",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "section"
        },
        "group": {
          "enum": [
            "epics",
            "current-work",
            "newly-added",
            "open-defects",
            "in-progress",
            "up-next",
            "blocked",
            "backlog",
            "later",
            "recently-done",
            "parent-group",
            "sub-epics",
            "not-in-epic",
            "all",
            "portfolio",
            "matches",
            "relationships"
          ]
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/issueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "enum": [
            "none",
            "suggested"
          ]
        },
        "disclosure": {
          "enum": [
            "open",
            "collapsed"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    },
    "epicSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "record"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "epic-summary"
        },
        "record": {
          "$ref": "#/$defs/issueRef"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "issueCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "record",
        "presentation",
        "primary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "issue-card"
        },
        "record": {
          "$ref": "#/$defs/issueRef"
        },
        "presentation": {
          "enum": [
            "card",
            "row"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "dependencyList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "record",
        "direction",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "dependency-list"
        },
        "record": {
          "$ref": "#/$defs/issueRef"
        },
        "direction": {
          "enum": [
            "prerequisites",
            "dependents"
          ]
        },
        "scope": {
          "enum": [
            "direct",
            "transitive"
          ]
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "by",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "board"
        },
        "by": {
          "enum": [
            "commitment",
            "phase",
            "workflow"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    },
    "taskBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "record"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/instance"
        },
        "kind": {
          "const": "task-brief"
        },
        "record": {
          "$ref": "#/$defs/issueRef"
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/questionMatch"
          },
          {
            "$ref": "#/$defs/epicMember"
          },
          {
            "$ref": "#/$defs/recordedRelation"
          },
          {
            "$ref": "#/$defs/readyCandidate"
          }
        ]
      }
    },
    "questionMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence"
      ],
      "properties": {
        "code": {
          "const": "question-match"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "enum": [
                  "title",
                  "story.outcome.text",
                  "story.implementation.text",
                  "story.protections.text",
                  "story.acceptance.text",
                  "story.deferrals.text",
                  "labels",
                  "state",
                  "stateReason"
                ]
              }
            }
          }
        }
      }
    },
    "epicMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence"
      ],
      "properties": {
        "code": {
          "const": "epic-member"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "epic"
            ],
            "properties": {
              "epic": {
                "$ref": "#/$defs/issueRef"
              }
            }
          }
        }
      }
    },
    "recordedRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence"
      ],
      "properties": {
        "code": {
          "const": "recorded-relation"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "record"
            ],
            "properties": {
              "relation": {
                "enum": [
                  "blocks",
                  "blocked-by",
                  "parent-of",
                  "child-of"
                ]
              },
              "record": {
                "$ref": "#/$defs/issueRef"
              }
            }
          }
        }
      }
    },
    "readyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence"
      ],
      "properties": {
        "code": {
          "const": "ready-candidate"
        },
        "evidence": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
