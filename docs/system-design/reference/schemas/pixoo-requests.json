              "idle",
              "loading",
              "playing",
              "paused",
              "reconnecting",
              "error"
            ]
          },
          "intent": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "stopped"
            ]
          }
        },
        "required": [
          "state",
          "intent"
        ],
        "additionalProperties": false
      },
      "logging": {
        "type": "object",
