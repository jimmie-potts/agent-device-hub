{
  "apiErrorSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "required": [
      "error"
    ]
  },
  "apiHash": {
    "type": "string",
    "pattern": "^[a-f0-9]{64}$"
  },
  "apiId": {
    "type": "string",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
  },
  "apiName": {
    "type": "string",
    "minLength": 1,
    "maxLength": 120,
    "description": "Trimmed by the service. Control characters U+0000–U+001F and U+007F are rejected."
  },
  "apiRevision": {
    "type": "integer",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991
  },
  "assetQuery": {
    "type": "object",
    "properties": {
      "offset": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "limit": {
        "default": 25,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "q": {
        "default": "",
        "type": "string",
        "maxLength": 120
      }
    },
    "additionalProperties": false
  },
  "catalogQuery": {
    "type": "object",
    "properties": {
      "q": {
        "default": "",
        "type": "string",
        "maxLength": 120
      },
      "offset": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "default": 25,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "additionalProperties": false
  },
  "deviceConfiguration": {
    "type": "object",
    "properties": {
      "ip": {
        "type": "string",
        "format": "ipv4",
        "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$",
        "description": "Canonical RFC1918 IPv4 only: 10/8, 172.16/12 or 192.168/16. Saving settings does not select device mode; changing the active configuration requires a restart."
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "firmware": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "profile": {
        "type": "string",
        "enum": [
          "simulator-v1",
          "pixoo64-smoke-2026-09-06"
        ]
      }
    },
    "required": [
      "ip",
      "profile"
    ],
    "additionalProperties": false
  },
  "diagnosticsSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "const": "ready"
      },
      "mode": {
        "type": "string",
