        "required": [
          "persistent"
        ],
        "additionalProperties": false
      },
      "limits": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "number",
            "const": 32
          },
          "eventClients": {
            "type": "number",
            "const": 16
          },
          "eventHistory": {
            "type": "number",
            "const": 32
          },
          "commandReceipts": {
            "type": "number",
            "const": 256
          },
          "playbackRenditions": {
            "type": "number",
            "const": 2
          }
        },
        "required": [
          "requests",
          "eventClients",
          "eventHistory",
          "commandReceipts",
          "playbackRenditions"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "status",
      "mode",
      "uptimeMs",
      "library",
      "device",
      "player",
      "logging",
      "limits"
    ],
    "additionalProperties": false
  },
