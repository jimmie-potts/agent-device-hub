  "cards": [
    {
      "dot": "rose",
      "title": "Expiry and effects",
      "items": [
        "Still queued: expired, no effect. Handler started, lost reply or missing outcome: uncertain-result.",
        "Cancellation ends waiting, not prior effects. retryable never permits resending a command."
      ]
    },
    {
      "dot": "cyan",
      "title": "Stored outcome, same identity",
      "items": [
        "Keep message ID, time, request and trace context across publication and restart.",
