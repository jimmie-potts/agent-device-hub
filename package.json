{
  "name": "agent-device-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Shared hub architecture and development workflow bootstrap",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "openspec": "node scripts/openspec.cjs",
    "check:workflow": "node scripts/check-workflow.cjs",
    "test:workflow": "node --test tests/workflow_checks.cjs",
    "build": "tsc -p tsconfig.json && tsc -p packages/mcp/tsconfig.json && tsc -p packages/lifecycle-contracts/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/mcp/tsconfig.json --noEmit && tsc -p packages/lifecycle-contracts/tsconfig.json --noEmit",
    "test:contracts": "npm run build && npm run test:contracts:built",
    "test:contracts:python": "python3 scripts/check-contracts.py",
    "package:contracts": "npm run build && node scripts/package-contracts.mjs",
    "test:package": "npm run build && npm run test:package:built",
    "test:mcp": "npm run build && npm run test:mcp:built",
    "test:mcp:protocol": "npm run build && npm run test:mcp:protocol:built",
    "package:mcp": "npm run build && node scripts/package-mcp.mjs",
    "test:mcp:package": "npm run build && npm run test:mcp:package:built",
    "test:lifecycle": "npm run build && npm run test:lifecycle:built",
    "test:lifecycle:python": "python3 scripts/check-lifecycle.py",
    "package:lifecycle": "npm run build && node scripts/package-lifecycle.mjs",
    "test:lifecycle:package": "npm run build && npm run test:lifecycle:package:built",
    "test:contracts:built": "node --test packages/contracts/tests/*.test.mjs",
    "test:package:built": "node scripts/package-contracts.mjs --test",
    "test:mcp:built": "node --test packages/mcp/tests/tools.test.mjs",
    "test:mcp:protocol:built": "node --test packages/mcp/tests/protocol.test.mjs",
    "test:mcp:package:built": "node scripts/package-mcp.mjs --test",
    "test:lifecycle:built": "node --test packages/lifecycle-contracts/tests/*.test.mjs",
    "test:lifecycle:package:built": "node scripts/package-lifecycle.mjs --test",
    "test:performance": "python scripts/check-performance.py && node scripts/check-performance-validators.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/mcp",
    "packages/lifecycle-contracts"
  ]
}
